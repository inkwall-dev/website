---
import { getCollection } from 'astro:content';
import Docs from '../../layouts/Docs.astro';

const pages = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
---
<Docs title="Docs" description="Inkwall documentation: getting started, upgrading, how it works, policies, operations, guides and the roadmap.">
  <h1>Documentation</h1>
  <p class="lede">
    These pages cover Inkwall v0.2.0: Traefik with Ingress and IngressRoute routes, installed with Helm. What isn't built yet
    is on the <a href="/docs/roadmap/">roadmap</a>. The <a href="https://github.com/inkwall-dev/inkwall/blob/v0.2.0/docs/README.md">docs
    index</a> and the design documents in the
    <a href="https://github.com/inkwall-dev/inkwall/tree/v0.2.0/docs/design">main repository</a> go deeper, and its
    <a href="https://github.com/inkwall-dev/inkwall/blob/v0.2.0/docs/glossary.md">glossary</a> defines Inkwall's terms.
  </p>
  <ul class="toc">
    {pages.map((p) => (
      <li>
        <a href={`/docs/${p.id}/`}>{p.data.title}</a>
        <span>{p.data.description}</span>
      </li>
    ))}
  </ul>
</Docs>

<style>
  .toc {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }
  .toc li {
    display: grid;
    gap: 0.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.9rem 1.1rem;
    background: var(--bg-raised);
  }
  .toc a {
    font-weight: 600;
    text-decoration: none;
  }
  .toc span {
    color: var(--text-muted);
  }
</style>
